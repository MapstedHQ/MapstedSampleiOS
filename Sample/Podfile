platform :ios, '16.0'

source 'https://cdn.cocoapods.org/'
source 'https://github.com/MapstedHQ/podspec.git'

use_frameworks!

target 'Sample' do
  pod 'mapsted-sdk-map-ui', '26.10.3'
end

target 'Sample_MapOnly' do
  pod 'mapsted-sdk-map', '26.10.3'
end

target 'Sample_LocSimulation' do
  pod 'mapsted-sdk-map-ui', '26.10.3'
end

# Some pods declare an older minimum iOS version than this app. Current Xcode
# versions refuse to build for anything below iOS 15, so raise every pod to the
# app's minimum (iOS 16.0).
post_install do |installer|
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 16.0
        config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '16.0'
      end
    end
  end
end
